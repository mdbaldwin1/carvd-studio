{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carvd.studio/schemas/router-tool.schema.json",
  "title": "Carvd Router Tool File",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "tool"],
  "properties": {
    "format": { "const": "carvd-router-tool" },
    "version": { "const": 1 },
    "tool": { "$ref": "#/definitions/tool" }
  },
  "definitions": {
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "revision": { "type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$" },
    "dimension": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
    "offset": { "type": "number", "minimum": -1000, "maximum": 1000 },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "start", "end", "diameter"],
      "properties": {
        "role": { "enum": ["cutter", "neck", "shank", "bearing"] },
        "start": { "$ref": "#/definitions/offset" },
        "end": { "$ref": "#/definitions/offset" },
        "diameter": { "$ref": "#/definitions/dimension" },
        "stackable": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "bearing" } } },
          "else": { "not": { "required": ["stackable"] } }
        }
      ]
    },
    "producedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileRevision", "profileSnapshot"],
      "properties": {
        "profileId": { "$ref": "#/definitions/nonBlank" },
        "profileRevision": { "$ref": "#/definitions/revision" },
        "profileSnapshot": {
          "$ref": "router-profile.schema.json#/definitions/profile"
        },
        "nominalSize": { "$ref": "#/definitions/dimension" },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scalable"],
          "properties": {
            "scalable": { "type": "boolean" },
            "minScale": { "$ref": "#/definitions/dimension" },
            "maxScale": { "$ref": "#/definitions/dimension" }
          },
          "allOf": [
            {
              "if": { "properties": { "scalable": { "const": false } } },
              "then": {
                "not": {
                  "anyOf": [
                    { "required": ["minScale"] },
                    { "required": ["maxScale"] }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "name",
        "source",
        "profileFamily",
        "cutterDiameter",
        "shankDiameter",
        "cuttingHeight"
      ],
      "properties": {
        "version": { "const": 1 },
        "revision": { "$ref": "#/definitions/revision" },
        "id": { "$ref": "#/definitions/nonBlank" },
        "name": { "$ref": "#/definitions/nonBlank" },
        "source": { "enum": ["generic", "manufacturer"] },
        "manufacturer": { "$ref": "#/definitions/nonBlank" },
        "sku": { "$ref": "#/definitions/nonBlank" },
        "sourceUrl": { "$ref": "#/definitions/nonBlank" },
        "profileFamily": { "$ref": "#/definitions/nonBlank" },
        "routerProfileId": { "$ref": "#/definitions/nonBlank" },
        "producedProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/definitions/producedProfile" }
        },
        "cutterDiameter": { "$ref": "#/definitions/dimension" },
        "shankDiameter": { "$ref": "#/definitions/dimension" },
        "cuttingHeight": { "$ref": "#/definitions/dimension" },
        "neckDiameter": { "$ref": "#/definitions/dimension" },
        "bearingDiameter": { "$ref": "#/definitions/dimension" },
        "envelopeVersion": { "const": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/definitions/section" }
        },
        "overallLength": { "$ref": "#/definitions/dimension" },
        "safeColletInsertion": { "$ref": "#/definitions/dimension" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "manufacturer" } } },
          "then": { "required": ["manufacturer", "sku"] }
        },
        {
          "if": { "required": ["sections"] },
          "then": { "required": ["envelopeVersion"] }
        },
        {
          "if": { "required": ["envelopeVersion"] },
          "then": { "required": ["sections"] }
        }
      ]
    }
  }
}
