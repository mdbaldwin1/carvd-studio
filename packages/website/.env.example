# Lemon Squeezy Configuration
# Get this from your Lemon Squeezy dashboard

# Direct checkout URL for your product
# Get this from Products > Your Product > Share > Checkout Link
# The ID at the end is the product/variant ID from Lemon Squeezy
# Example: https://yourstore.lemonsqueezy.com/checkout/buy/abc123
VITE_LEMON_SQUEEZY_CHECKOUT_URL=https://yourstore.lemonsqueezy.com/checkout/buy/your_product_id

# PostHog website analytics (public project token; leave VITE_POSTHOG_KEY blank to disable delivery)
# Use separate development and production PostHog projects.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Lemon Squeezy webhook server configuration (never expose these in the client bundle)
# Subscribe this endpoint only to Lemon Squeezy order_created events.
LEMON_SQUEEZY_WEBHOOK_SECRET=
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_ID_SALT=

# GitHub Releases Configuration
# Used for download URLs

# GitHub repository in format "owner/repo"
VITE_GITHUB_REPO=mdbaldwin1/carvd-studio

# Current app version (must match GitHub release tag)
VITE_APP_VERSION=1.0.0
