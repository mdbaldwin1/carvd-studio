{
  "version": 2,
  "project": {
    "name": "Heron - Oak and Walnut Wall Cabinet",
    "createdAt": "2026-10-20T18:36:36.433Z",
    "modifiedAt": "2026-10-20T20:02:22.972Z",
    "units": "imperial",
    "gridSize": 0.0625,
    "kerfWidth": 0.125,
    "overageFactor": 0.1,
    "projectNotes": "HERON | Editable wall cabinet design study\n36 W x 24 H x 10 D inches; pull adds 1/2 inch. Oak case, walnut frame/fronts, maple drawers. Created manually in Carvd Studio. Prevent Overlap is ON; keep it enabled.\n\nDoor and drawer-front reveals: 1/8 inch. Complementary 45-degree French cleats. Fit joints to actual stock; test on scrap. Keep the oak panel free in its grooves and verify seasonal movement.\n\nNot a shop-tested build plan or load-rated design. Specify hinges, catch, drawer runners/stops, back attachment and a structural cleat-to-case connection before building. Do not rely on the 1/4-inch back to carry the cabinet. Hardware/fastener holes are not modeled. Prices are placeholders.\n\nWalkthrough and review notes: carvd-studio.com/learn/heron-wall-cabinet",
    "stockConstraints": {
      "constrainDimensions": true,
      "constrainGrain": true,
      "constrainColor": true,
      "preventOverlap": true
    }
  },
