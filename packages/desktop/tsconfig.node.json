{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "outDir": "./out",
    "rootDir": ".",
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/preload/**/*",
    "electron.vite.config.ts",
    "tests/e2e/helpers/**/*"
  ]
}
